<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.evmax.calibration-alert</string>

    <!-- Weekly calibration tripwire. Runs `evmax cleanup calibration-alert`,
         which is QUIET unless a sector shows a real, consistent calibration
         bias (n>=30 resolved rows, one-signed error across buckets, >=4pp).
         When one drifts it POSTs the sector + the exact `recalibrate --sector`
         fix to the configured Slack/Discord webhook (no-op if none set).
         Read-only on predictions.db. StartCalendarInterval fires Mondays 09:15;
         a firing missed while asleep runs on the next wake. Do NOT load this
         until the `calibration-alert` command is in the checkout this plist
         points at (WorkingDirectory below) — it ships in the calibration-loop
         PR; loading earlier just errors weekly. Install:
           cp scripts/launchd/com.evmax.calibration-alert.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.evmax.calibration-alert.plist
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ktzeng/Projects/evmax/.venv/bin/evmax</string>
        <string>cleanup</string>
        <string>calibration-alert</string>
        <string>--weeks</string>
        <string>8</string>
        <string>--notify</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ktzeng/Projects/evmax</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/ktzeng/Projects/evmax/logs/launchd.calibration-alert.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/ktzeng/Projects/evmax/logs/launchd.calibration-alert.err</string>
</dict>
</plist>
