# ── Kalshi ────────────────────────────────────────────────────────────────────
KALSHI_API_KEY_ID=your_kalshi_key_id_here
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi_private_key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Sharp odds come from the Pinnacle guest API (guest.api.arcadia.pinnacle.com),
# which requires no credentials — there is no sharp-odds API key to configure.

# ── Polymarket US ─────────────────────────────────────────────────────────────
# Market data is public (no auth). The Ed25519 key pair is needed only for the
# authenticated paths: the live TOTAL-WEALTH balance fetch (agents balance /
# --bankroll-venue, sized as cash + open positions) and, later, trading.
# Get the keyId + secretKey from polymarket.us/developer.
POLYMARKET_API_KEY=your_polymarket_key_id_here
POLYMARKET_US_SECRET_KEY=your_polymarket_ed25519_secret_here
# Per-sector live firewall: comma-separated sectors allowed to place LIVE bets
# on Polymarket US (mirrors the Kalshi per-category modes). Empty = firewall up
# for all sectors unless POLYMARKET_US_LIVE=true (master switch). Default: wnba.
POLYMARKET_US_LIVE_SECTORS=wnba

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./evmax.db

# ── Simulation ─────────────────────────────────────────────────────────────────
INITIAL_BANKROLL=10000.0
MAX_KELLY_FRACTION=0.05

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
